# Copy to .env on the EC2 VM. Do not commit the real file.
SUNLENA_HOST=sunlena.example.com

POSTGRES_DB=sunlena
POSTGRES_USER=sunlena
# Generate a 32-byte base64url password: node -p "require('crypto').randomBytes(32).toString('base64url')"
POSTGRES_PASSWORD=replace_with_a_43_character_base64url_secret
SUNLENA_MEDIA_SIGNING_SECRET=replace_with_a_random_64_character_hex_secret

FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id

APPLE_SEARCH_COUNTRY=IN

# Select yt-dlp (default) or Cobalt; self-hosted Cobalt is added by compose.cobalt.yaml.
SUNLENA_MEDIA_EXTRACTOR=yt-dlp
# With Cobalt selected, YouTube URLs and catalog searches still use yt-dlp (PO tokens via bgutil).
SUNLENA_YOUTUBE_EXTRACTOR=yt-dlp

# Optional Cobalt overlay settings; no Cobalt service starts unless compose.cobalt.yaml is included.
SUNLENA_COBALT_API_BASE_URL=http://cobalt:9000/
SUNLENA_COBALT_API_TOKEN=
SUNLENA_COBALT_AUTH_SCHEME=Api-Key
SUNLENA_COBALT_REQUEST_TIMEOUT_SECONDS=30
SUNLENA_COBALT_DOWNLOAD_TIMEOUT_SECONDS=180
COBALT_API_INSTANCE_COUNT=1
COBALT_API_AUTH_REQUIRED=false
COBALT_API_KEY_URL=
COBALT_TUNNEL_LIFESPAN=90
COBALT_DURATION_LIMIT=1800

# Copy to .env on the Lightsail VM. Do not commit the real file.
SUNLENA_HOST=sunlena.example.com

POSTGRES_DB=sunlena
POSTGRES_USER=sunlena
# Generate a 32-byte base64url password: node -p "require('crypto').randomBytes(32).toString('base64url')"
POSTGRES_PASSWORD=replace_with_a_43_character_base64url_secret
SUNLENA_MEDIA_SIGNING_SECRET=replace_with_a_random_64_character_hex_secret

FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id

APPLE_SEARCH_COUNTRY=IN

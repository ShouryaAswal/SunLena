# Local development defaults. Never put real secrets in this file.
API_PORT=8000
WEB_PORT=5173
POSTGRES_DB=sunlena
POSTGRES_USER=sunlena
POSTGRES_PASSWORD=local_only_change_me

# Firebase project used by the browser app and the API token verifier.
FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Apple Search works without an API key. Use an ISO country code.
APPLE_SEARCH_COUNTRY=IN

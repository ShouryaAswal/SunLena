# Local development defaults. Never put real secrets in this file.
API_PORT=8000
WEB_PORT=5173
POSTGRES_DB=sunlena
POSTGRES_USER=sunlena
POSTGRES_PASSWORD=local_only_change_me

# Firebase project used by the browser app and the API token verifier.
FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Apple Search works without an API key. Use an ISO country code.
APPLE_SEARCH_COUNTRY=IN

# Optional Cobalt backend. Use the overlay: docker compose -f compose.yaml -f compose.cobalt.yaml up --build
# Leave blank/unchanged for the default yt-dlp backend.
SUNLENA_MEDIA_EXTRACTOR=yt-dlp
# With Cobalt selected, YouTube URLs and catalog searches still use yt-dlp
# (PO tokens via bgutil). Set to cobalt only if your Cobalt has a YouTube session server.
SUNLENA_YOUTUBE_EXTRACTOR=yt-dlp
SUNLENA_COBALT_API_BASE_URL=http://cobalt:9000/
SUNLENA_COBALT_API_TOKEN=
SUNLENA_COBALT_AUTH_SCHEME=Api-Key
SUNLENA_COBALT_REQUEST_TIMEOUT_SECONDS=30
SUNLENA_COBALT_DOWNLOAD_TIMEOUT_SECONDS=180
COBALT_API_INSTANCE_COUNT=1
COBALT_API_AUTH_REQUIRED=false
COBALT_API_KEY_URL=
COBALT_TUNNEL_LIFESPAN=90
COBALT_DURATION_LIMIT=1800
